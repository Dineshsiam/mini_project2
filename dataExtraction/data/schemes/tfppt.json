                            {
                                "type": "paragraph",
                                "children": [
                                    {
                                        "text": "Yes, 20% of the beneficiaries under this scheme are reserved for women farmers.\n"
                                    }
                                ]
                            }
                        ],
                        "answer_md": "Yes, 20% of the beneficiaries under this scheme are reserved for women farmers.\n\n"
                    },
                    {
                        "question": "Is the scheme available for farmers cultivating other crops?",
                        "answer": [
