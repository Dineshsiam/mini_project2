            "en": {
                "faqs": [
                    {
                        "question": "What is the purpose of the “Training of Farmers on Pulses Production Technologies” scheme?",
                        "answer": [
                            {
                                "type": "paragraph",
                                "children": [
                                    {
                                        "text": "This scheme provides training on modern techniques for pulses production, along with financial assistance to participating farmers.\n"
                                    }
                                ]
                            }
                        ],
                        "answer_md": "This scheme provides training on modern techniques for pulses production, along with financial assistance to participating farmers.\n\n"
                    },
                    {
                        "question": "Who qualifies for this scheme?",
                        "answer": [
                            {
                                "type": "paragraph",
                                "children": [
                                    {
                                        "text": "Farmers who cultivate pulses are eligible, with special focus on SC/ST (24%) and women farmers (20%).\n"
                                    }
                                ]
                            }
                        ],
                        "answer_md": "Farmers who cultivate pulses are eligible, with special focus on SC/ST (24%) and women farmers (20%).\n\n"
                    },
                    {
                        "question": "Are there any age or income limitations?",
                        "answer": [
                            {
                                "type": "paragraph",
                                "children": [
                                    {
                                        "text": "No, there are no specific age or income requirements for this scheme.\n"
                                    }
                                ]
                            }
                        ],
                        "answer_md": "No, there are no specific age or income requirements for this scheme.\n\n"
                    },
                    {
                        "question": "What financial support is provided under this scheme?",
                        "answer": [
                            {
                                "type": "paragraph",
                                "children": [
                                    {
                                        "text": "Each batch of 50 farmers receives ₹15,000/- in financial assistance for the training.\n"
                                    }
                                ]
                            }
                        ],
                        "answer_md": "Each batch of 50 farmers receives [?]15,000/- in financial assistance for the training.\n\n"
                    },
                    {
                        "question": "How can farmers apply for this scheme?",
                        "answer": [
                            {
                                "type": "paragraph",
                                "children": [
                                    {
                                        "text": "Applications can be submitted to the Assistant Agricultural Officer at the village level, or to the relevant agricultural officials at the block and district levels.\n"
                                    }
                                ]
                            }
                        ],
                        "answer_md": "Applications can be submitted to the Assistant Agricultural Officer at the village level, or to the relevant agricultural officials at the block and district levels.\n\n"
                    },
                    {
                        "question": "What documents are necessary for the application?",
                        "answer": [
                            {
                                "type": "paragraph",
                                "children": [
                                    {
                                        "text": "Applicants need to provide identity proof, land ownership documents, caste certificates (if applicable), and evidence of pulse cultivation.\n"
                                    }
                                ]
                            }
                        ],
                        "answer_md": "Applicants need to provide identity proof, land ownership documents, caste certificates (if applicable), and evidence of pulse cultivation.\n\n"
                    },
                    {
                        "question": "Is there a reservation for women farmers?",
